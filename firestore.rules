rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de seguridad de Firestore (US-09 + Social)
//
// Datos privados de cada usuario:  users/{uid}/data/{documento}  → solo el dueño.
// Capa social (amigos + ranking):  usernames, friendships, publicProfiles → canal
// controlado (ver cada match). Todo lo demás queda denegado por defecto.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // Id determinista de una amistad: mismo doc para el par (A,B) sea cual sea el orden.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // ---- Datos privados del usuario (esquema plano, solo el dueño) ----
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- @usuarios: unicidad + resolución (coincidencia exacta) ----
    // Un doc por @usuario. Se reclama una vez (create solo si no existe). Legible por
    // autenticados para resolver @usuario -> uid al enviar solicitud (no lista a nadie).
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- Amistades: un doc por pareja, estado pending|accepted ----
    match /friendships/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // Enviar solicitud: creas el doc si eres del par y tú eres quien la pide.
      allow create: if request.auth != null
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Aceptar: solo la OTRA parte pasa de pending a accepted, sin tocar el par.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.users == resource.data.users
        && request.resource.data.requestedBy == resource.data.requestedBy;
      // Rechazar / cancelar / eliminar amistad: cualquiera del par.
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // ---- Perfil público: SOLO rango calculado + nombre/nivel. Legible por amigos ----
    match /publicProfiles/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)))
         && get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))).data.status == 'accepted')
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Liga mensual global (US-LIGA) ----
    // El cliente escribe SU entrada (puntos calculados en cliente, con topes de cordura). Los
    // campos `league` y `groupId` son del SERVIDOR (Cloud Functions): el cliente no los puede
    // fijar ni cambiar. Grupos, temporadas y medallas los escriben SOLO las Functions (admin,
    // que se salta estas reglas). Ver docs/us-liga.md y docs/us-liga-fase2-deploy.md.
    match /leagueMembers/{uid} {
      allow read: if request.auth != null;
      // Alta: uid propio y puntos en rango. league/groupId aún no existen (los pone el trigger).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000000;
      // Actualización (merge): puntos en rango y SIN tocar league/groupId (server-only).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= 1000000
        && (!('league' in request.resource.data) || request.resource.data.league == resource.data.get('league', null))
        && (!('groupId' in request.resource.data) || request.resource.data.groupId == resource.data.get('groupId', null));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Temporadas: legibles por autenticados; las escribe solo el cierre mensual (Function).
    match /leagueSeasons/{sid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Grupos (~30) y su espejo de miembros: legibles por autenticados (ver tu grupo);
    // los escribe solo el servidor (trigger / cierre mensual).
    match /leagueGroups/{sid}/groups/{gid} {
      allow read: if request.auth != null;
      allow write: if false;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    // Doc-índice interno de grupos abiertos (lo usa el trigger para asignar hueco).
    match /leagueGroups/{sid}/meta/{league} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Medallas de temporada: cada quien lee SOLO las suyas; las escribe solo el cierre mensual.
    match /leagueMedals/{uid}/seasons/{sid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Cualquier otra ruta: denegada por defecto.
  }
}
